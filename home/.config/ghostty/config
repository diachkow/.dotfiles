##############################
### Appearance preferences ###
##############################

title = " "
macos-titlebar-proxy-icon = "hidden"

theme = "gruvbox-material-mix-medium-dark"
window-theme = "ghostty"
macos-titlebar-style = "tabs"
macos-icon = "blueprint"

cursor-style = "block"
cursor-style-blink = "false"
shell-integration-features = "no-cursor"

font-family = "JetBrains Mono"
font-size = "16"

# Disable ligatures
# font-feature = "-liga"
# font-feature = "-calt"
# font-feature = "-dlig"

# Terminal Initial Size
window-width = 239
window-height = 59

############################
### Behavior preferences ###
############################

macos-option-as-alt = "true"
window-save-state = "always"
quit-after-last-window-closed = "true"
shell-integration = "zsh"

###################
### Keybindings ###
###################

keybind = "unconsumed:cmd+shift+r=reload_config"

# Unbind 'Open new tab'
keybind = "cmd+t=unbind"

# Unbind 'Open new window'
keybind = "cmd+n=unbind"

# Unbind 'Toggle fullscreen'
keybind = "cmd+enter=unbind"

# Unbind 'Open new pane'
keybind = "cmd+d=unbind"

# Tab switching with Option+number
keybind = ctrl+b>1=goto_tab:1
keybind = ctrl+b>2=goto_tab:2
keybind = ctrl+b>3=goto_tab:3

# Splits
keybind = ctrl+b>minus=new_split:down
keybind = ctrl+b>shift+backslash=new_split:right
keybind = opt+left=goto_split:left
keybind = opt+down=goto_split:down
keybind = opt+up=goto_split:up
keybind = opt+right=goto_split:right

# Config for claude code
keybind = shift+enter=text:\x1b\r

{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["./herdr-tui-session.js"],
  "theme": {
    "name": "catppuccin-mocha-local",
    "mode": "system"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word",
    "single": false,
    "view": "unified"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "verbosity": "medium",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  },
  "prompt": {
    "paste": "full"
  }
}

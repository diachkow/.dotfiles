{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "share": "disabled",
  "autoupdate": false,
  "lsp": false,
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "docker compose config": "deny"
    },
    "external_directory": {
      "~/coding/**": "allow",
      "/var/folders/**": "allow",
      "/tmp/**": "allow",
      "~/.config/**": "allow",
      "~/.local/share/**": "allow"
    }
  }
}

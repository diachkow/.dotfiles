{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "agents": {
    "plan": {
      "disabled": true
    }
  },
  "share": "disabled",
  "update": "disable",
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "openai", "effect": "allow" },
      { "action": "provider.use", "resource": "github-copilot", "effect": "allow" }
    ]
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "docker compose config", "effect": "deny" },
    { "action": "external_directory", "resource": "~/coding/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/folders/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/*", "effect": "allow" }
  ],
  "plugins": [
    {
      "package": "@plannotator/opencode@0.27.25",
      "options": { "workflow": "manual" }
    },
    "@dietrichgebert/ponytail@4.12.0"
  ]
}

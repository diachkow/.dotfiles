{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "share": "disabled",
  "autoupdate": false,
  "lsp": false,
  "enabled_providers": ["opencode", "opencode-go"],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "docker compose config": "deny"
    },
    "external_directory": {
      "~/coding/**": "allow",
      "/var/folders/**": "allow",
      "/tmp/**": "allow",
      "~/.config/**": "allow",
      "~/.local/share/**": "allow"
    }
  },
  "plugin": [
    ["@plannotator/opencode@v0.25.1", {"workflow": "manual"}]
  ],
  "agent": {
    "build": {
      "textVerbosity": "low"
    }
  }
}

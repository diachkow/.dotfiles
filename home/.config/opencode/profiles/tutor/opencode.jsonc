{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "tutor",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "permission": {
    "edit": "deny",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git status *": "allow"
    },
    "websearch": "allow"
  }
}
